# Base de datos (Railway Postgres en producción, local en desarrollo)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veya?schema=public"

# App
PORT=3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Catálogos externos
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
ANILIST_BASE_URL="https://graphql.anilist.co"
OPEN_LIBRARY_BASE_URL="https://openlibrary.org"
CORS_ORIGIN=

# IA (recomendaciones de libros) — opcional; sin keys se usa el motor de géneros
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-flash-latest"
